{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(/docs/adr/**)",
      "Edit(/AGENTS.md)",
      "Edit(/scripts/check-docs.sh)",
      "Edit(/.claude/settings.json)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/check-docs.sh\" >/dev/null || exit 2"
          }
        ]
      }
    ]
  }
}
