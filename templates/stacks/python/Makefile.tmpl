# uv owns the environment: `uv run` always uses this repo's .venv, so a login
# shell that defaults to a sibling repo's venv (which has no {{PROJECT_PKG}}
# package) cannot leak in. Never call a bare `python` or `pytest` here.
.PHONY: install check test lint fmt

install:
	uv sync

# The full gate: the local mirror of CI.
check: lint test

test:
	uv run pytest

lint:
	uv run ruff check .
	uv run ruff format --check .

fmt:
	uv run ruff format .
