# Every interpreter path is pinned to this repo's venv. The login shell may
# default to a sibling repo's venv, which has no {{PROJECT_SLUG}} package and
# silently breaks a bare `python` — so never rely on PATH here.
VENV := .venv

.PHONY: install test lint fmt

install:
	python3 -m venv $(VENV) && $(VENV)/bin/python -m pip install -e ".[dev]"

test:
	$(VENV)/bin/pytest

lint:
	$(VENV)/bin/ruff check .

fmt:
	$(VENV)/bin/ruff format .
