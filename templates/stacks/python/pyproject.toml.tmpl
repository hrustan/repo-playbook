[build-system]
requires = ["hatchling>=1.27"] # 1.27 is the first with SPDX license metadata
build-backend = "hatchling.build"

[project]
name = "{{PROJECT_SLUG}}"
version = "0.1.0"
description = "{{ONE_LINER}}"
requires-python = ">=3.11"
license = "MIT" # SPDX expression; "LicenseRef-Proprietary" for private research repos
license-files = ["LICENSE"]
dependencies = [
  # Floor-pin, and justify anything non-obvious with a trailing comment.
]

[dependency-groups]
dev = ["pytest>=9.0", "ruff>=0.17"]

[tool.hatch.build.targets.wheel]
packages = ["src/{{PROJECT_PKG}}"]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
pythonpath = ["src"]
