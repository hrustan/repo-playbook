# Hand-maintained: add only patterns this repo actually produces, with a comment
# saying why. Resist pasting a 150-line template.

# OS / editor noise
.DS_Store

# Secrets (never commit; names are listed in .env.example)
.env
.env.*
!.env.example

# Pulled/cached data — commit findings, not dumps. Root-anchored so a source
# directory named data/ deeper in the tree stays tracked.
/data/

# Agent tooling (machine-local; permission allowlists accrete per session)
.claude/settings.json
.claude/settings.local.json
